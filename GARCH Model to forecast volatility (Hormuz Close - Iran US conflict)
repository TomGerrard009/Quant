# Using MLE for GARCH parameters
def stationarity_constraint(params):
    omega, alpha, beta = params
    return 1 - alpha - beta

def garch_neg_loglik(params, returns):
    omega, alpha, beta = params
    T = len(returns)
    
    sigma2 = np.zeros(T)
    sigma2[0] = np.var(returns)

    for t in range(1, T):
        sigma2[t] = omega + alpha * returns[t-1]**2 + beta * sigma2[t-1]
    
    ll = -0.5 * np.sum(
        np.log(2 * np.pi * sigma2) +
        (returns**2) / sigma2
    )
    
    return -ll


initial_guess = [0.0, 0.5, 0.5]
returns = np.array(TTF['log_ret'][-100:].values)

result = minimize(
    garch_neg_loglik,
    initial_guess,
    args=(returns,),
    method="L-BFGS-B",
    bounds=[(1e-8, None), (1e-8, 1), (1e-8, 1)],
    constraints={'type': 'ineq', 'fun': lambda x: 1 - x[1] - x[2]}
)

omega_hat, alpha_hat, beta_hat = result.x

alpha_hat = 0.35
beta_hat  = 0.64998

Close = TTF['Close', 'TTF=F'].values
last_vol = (TTF['Rolling Daily Vol'][-1:].values)[0]

np.random.seed(68)

N = 21*6
t = np.linspace(0, 1, N)
T = 1
dt = T/N
asset = np.zeros(N)
asset[0] = Close[-1]
stnd_dev_65 = np.zeros(N)
stnd_dev_65[0] = last_vol
error = np.zeros(N)
Z = np.random.standard_normal(N)
error[0] = stnd_dev_65[0]*Z[0]
returns_65 = np.zeros(N)
returns_65[0] = TTF['log_ret'].iloc[-1] + 1

lam0 = 0.01
mu_J = 2
sigma_J = 0.1
# Bernoulli indicator
    
# Jump sizes
Y = np.random.normal(mu_J, sigma_J, N)

lam_t_series = np.zeros(N)
I = np.zeros(N)
jump = np.zeros(N)
lam_t_series[0] = lam0

kappa = 0.89   # decay of jump intensity (VERY important)
eta = 0.15     # excitation strength

for i in range(1, N):

    # continuous shock
    cont_shock = stnd_dev_65[i-1] * Z[i-1]
    I[i] = np.random.binomial(1, lam_t_series[i])

    # --- Hawkes-style intensity ---
    lam_t_series[i] = (
        lam0
        + kappa * (lam_t_series[i-1] - lam0)
        + eta * I[i-1]
    )

    lam_t_series[i] = min(lam_t_series[i], 1)

    # variance update
    stnd_dev_65[i] = np.sqrt(
        omega_hat
        + alpha_hat * cont_shock**2
        + beta_hat * stnd_dev_65[i-1]**2
    )

    # jump
    jump[i] = I[i] * Y[i]

    returns_65[i] = stnd_dev_65[i] * Z[i] + jump[i]
    asset[i] = asset[i-1] * np.exp(returns_65[i])

# Plot volatility path and asset path
