#Crank-Nicolson (EU Options)
def crank_nicolson_option(
    S0,
    K,
    T,
    r,
    sigma,
    S_max=4.0,
    M=200,     # asset price steps
    N=200,     # time steps
    option_type="call"
):

    # Grid setup
    S_max = S_max * K
    dS = S_max / M
    dt = T / N

    S = np.linspace(0, S_max, M + 1)
    V = np.zeros(M + 1)

    # Terminal condition (payoff)
    if option_type == "call":
        V = np.maximum(S - K, 0)
    else:
        V = np.maximum(K - S, 0)

    # Coefficients
    i = np.arange(1, M)
    alpha = 0.25 * dt * (sigma**2 * i**2 - r * i)
    beta  = -0.5 * dt * (sigma**2 * i**2 + r)
    gamma = 0.25 * dt * (sigma**2 * i**2 + r * i)

    # Tridiagonal matrices A and B
    A = np.zeros((M-1, M-1))
    B = np.zeros((M-1, M-1))

    np.fill_diagonal(A, 1 - beta)
    np.fill_diagonal(B, 1 + beta)

    np.fill_diagonal(A[1:], -alpha[1:])
    np.fill_diagonal(A[:,1:], -gamma[:-1])

    np.fill_diagonal(B[1:], alpha[1:])
    np.fill_diagonal(B[:,1:], gamma[:-1])

    # Time stepping (backward)
    for _ in range(N):
        rhs = B @ V[1:-1]

        # Boundary conditions
        if option_type == "call":
            rhs[-1] += gamma[-1] * (S_max - K * np.exp(-r * dt))
        else:
            rhs[0] += alpha[0] * (K * np.exp(-r * dt))

        # Solve linear system
        V[1:-1] = np.linalg.solve(A, rhs)

    # Interpolate price at S0
    return np.interp(S0, S, V)

# Black-Scholes Pricing to Calculate Implied Vol 
def bs_price(S, K, T, r, sigma, option_type="call"):
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    d2 = d1 - sigma * np.sqrt(T)

    if option_type == "call":
        return S * norm.cdf(d1) - K * np.exp(-r * T) * norm.cdf(d2)
    else:
        return K * np.exp(-r * T) * norm.cdf(-d2) - S * norm.cdf(-d1)

def bs_vega(S, K, T, r, sigma):
    d1 = (np.log(S / K) + (r + 0.5 * sigma**2) * T) / (sigma * np.sqrt(T))
    return S * norm.pdf(d1) * np.sqrt(T)

def implied_vol(
    market_price,
    S,
    K,
    T,
    r,
    option_type="call",
    tol=1e-6,
    max_iter=100
):
    sigma = 0.2  # initial guess

    for _ in range(max_iter):
        price = bs_price(S, K, T, r, sigma, option_type)
        vega = bs_vega(S, K, T, r, sigma)

        diff = price - market_price
        if abs(diff) < tol:
            return sigma

        sigma -= diff / vega

    raise RuntimeError("Implied vol did not converge")

