def calc_atr(GOOG, period=20): # 20 for 3.33 day ATR on 4H intervals
    high_low = GOOG['High'] - GOOG['Low']
    high_close = abs(GOOG['High'] - GOOG['Close'].shift())
    low_close = abs(GOOG['Low'] - GOOG['Close'].shift())
    tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)
    atr = tr.rolling(window=period).mean()
    return atr

