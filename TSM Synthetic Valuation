# Heston Monte Carlo for conservative valuation (2)
weights=None

kappa = 2.0  # speed of mean reversion
theta = 0.04  # long-run variance (20% vol^2)
sigma_v = 0.3   # vol of vol
rho = -0.7    # negative correlation typical for equities
v0 = 0.04     # initial variance

mu = 0.05

z1 = np.random.normal(size=(steps, n_sims))
z2 = np.random.normal(size=(steps, n_sims))
z2 = rho*z1 + np.sqrt(1-rho**2)*z2

S = np.zeros((steps + 1, n_sims))
V = np.zeros((steps + 1, n_sims))

S[0, :] = spot
V[0, :] = v0

for t in range(1, steps + 1):   # full truncation Euler
    V[t] = np.maximum(
        V[t-1] + kappa*(theta - V[t-1])*dt + sigma_v*np.sqrt(np.maximum(V[t-1],0)*dt) * z2[t-1],
    0
    )
    #Price Process
    S[t] = S[t-1] *np.exp(
        (mu-0.5*V[t-1])*dt + np.sqrt(V[t-1]*dt) * z1[t-1]
    )
    if weights is None:
        weights = np.ones(n_sims)

    weights = np.asarray(weights)
    weights = weights / np.sum(weights)  # normalize

    # ---- Compute mean weighted paths ----
    mean_weighted_S_TSM = S @ weights
    mean_weighted_V_TSM = V @ weights

    time_grid = np.linspace(0, T, steps + 1)

terminal_prices = S[-1]

p5, p25, p50, p75, p95 = np.percentile(terminal_prices, [5, 25, 50, 75, 95])
mean_terminal = terminal_prices.mean()


